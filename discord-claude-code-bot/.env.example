# Discord Bot Token（Discord Developer Portalから取得）
DISCORD_TOKEN=your-discord-bot-token-here

# --- APIキー設定（どちらか一方のみ設定、両方省略も可） ---
#
# [方法1] Claude Code Pro/Maxプランを利用する場合:
#   APIキーは不要。事前に `claude auth login` でログインしておくだけでOK。
#
# [方法2] OpenRouter経由で利用する場合:
#   OPENROUTER_API_KEY=your-openrouter-api-key-here
#   MODEL=anthropic/claude-sonnet-4-20250514

# 使用するモデル（省略時: claude-sonnet-4-20250514）
# Pro/Maxプラン時はClaudeのモデルID、OpenRouter利用時は anthropic/... 形式
# MODEL=claude-sonnet-4-20250514

# AIの性格・口調のカスタマイズ（省略時: デフォルトのClaude Code）
# Claude Codeの機能はそのままに、末尾に追加される
# 例: 友達のようにタメ口で話すアシスタント
# SYSTEM_PROMPT=あなたはユーザーの親友です。タメ口で、明るくフレンドリーに話してください。絵文字も積極的に使ってください。

# 許可するDiscordユーザーID（カンマ区切りで複数指定可、省略時は全ユーザー許可）
# ALLOWED_USER_IDS=123456789,987654321

# メンション不要で全メッセージに反応するチャンネルID（カンマ区切りで複数指定可）
# /cron-id コマンドでチャンネルIDを確認できます
# AUTO_CHANNELS=123456789,987654321

# Claude Codeの作業ディレクトリ（省略時: カレントディレクトリ）
# WORK_DIR=/path/to/your/project

# --- マルチエージェント設定 ---
# コーディングエージェントの相談内容を表示するチャンネルID
# 設定するとクロウがコーディング依頼を自動でコーディングエージェントに相談し、
# このチャンネルにやり取りが投稿されます
# AGENT_CHAT_CHANNEL_ID=123456789
#
# コーディングエージェント専用モデル（省略時はMODELと同じモデルを使用）
# メインボットと異なるモデルを使いたい場合に設定
# 例: メインはSonnet、コーディングはOpusなど
# CODING_AGENT_MODEL=anthropic/claude-opus-4-20250514

# --- ベクトル検索（RAG）設定 ---
# 設定するとメモリ検索がキーワード一致からベクトル類似度検索に切り替わります
# 未設定の場合はキーワード検索にフォールバック
#
# [OpenAI の場合]
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_MODEL=text-embedding-3-small   # 省略時のデフォルト
#
# [Voyage AI の場合（Anthropic推奨）]
# EMBEDDING_API_KEY=pa-...
# EMBEDDING_BASE_URL=https://api.voyageai.com/v1
# EMBEDDING_MODEL=voyage-3-lite
